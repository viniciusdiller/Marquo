{
  "name": "marquo",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "qs": "^6.16.0",
      "lodash": "^4.18.1",
      "body-parser": "^1.20.6",
      "path-to-regexp": "^1.9.0",
      "ajv@>=8 <9": "^8.18.0",
      "fast-uri@>=3 <4": "^3.1.6",
      "glob@>=10 <11": "^10.5.0",
      "js-yaml@>=3 <4": "^3.15.2",
      "js-yaml@>=4 <5": "^4.3.2",
      "picomatch@>=4 <5": "^4.0.4",
      "tmp@<0.1": "^0.2.6",
      "webpack@>=5 <6": "^5.104.1",
      "file-type@>=20 <21": "^21.3.2",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-36xv-jgw5-4q75"
      ]
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "pnpm --filter @marquo/database db:studio",
    "db:seed": "pnpm --filter @marquo/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
