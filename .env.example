# Postgres — usado por packages/database e apps/api
DATABASE_URL="postgresql://totalagenda_app:totalagenda_dev@localhost:5432/totalagenda_dev?schema=public"

# apps/backend
PORT=3001
# Mínimo de 32 caracteres (o boot falha se for menor). Gere com: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="12h"
FRONTEND_URL="http://localhost:3000"
# Origem do site institucional (opcional): libera CORS para ele ler os preços em GET /plans.
# SITE_URL="http://localhost:5173"
# Só em produção, atrás de proxy reverso/CDN: nº de proxies confiáveis (ex.: 1). Sem isso o rate
# limit por IP enxerga o IP do proxy. Não defina em dev local.
# TRUST_PROXY_HOPS=1
# Segredo COMPARTILHADO com o frontend (mesmo valor nos dois .env) para assinar o IP do visitante
# nas chamadas server-side, senão o throttle por IP vê só o IP do servidor Next e limita o site
# inteiro junto. 32+ caracteres (openssl rand -hex 32). Opcional em dev; OBRIGATÓRIO com
# NODE_ENV=production (o boot falha sem ele).
# CLIENT_IP_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"

# Cobrança (Mercado Pago: cartão recorrente e Pix mensal). Opcional em desenvolvimento: sem o token as rotas de
# cobrança respondem 503 e a tela de plano só informa. Em PRODUÇÃO, com o token, o boot exige também o segredo do
# webhook e a URL pública do backend.
# Access Token da aplicação (Suas integrações > Credenciais). TEST-... em teste, APP_USR-... em produção.
# MERCADOPAGO_ACCESS_TOKEN="TEST-..."
# Segredo do webhook (Suas integrações > Webhooks), 16+ caracteres. Confere o x-signature das notificações.
# MERCADOPAGO_WEBHOOK_SECRET="..."
# URL pública do backend, sem barra no fim: vira o notification_url enviado ao Mercado Pago.
# BACKEND_PUBLIC_URL="https://api.seudominio.com.br"

# API interna de suporte (/internal/*), chamada só pelo Admin-TotalSoftware. Segredo COMPARTILHADO com o
# Admin (mesmo valor nos dois; 32+ caracteres; openssl rand -hex 32) para assinar (HMAC) cada requisição.
# Opcional em dev (sem ele a API responde 403 a tudo); OBRIGATÓRIO com NODE_ENV=production. Em produção,
# restrinja /internal/ no proxy ao IP do Admin.
# INTERNAL_API_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"

# Conta da plataforma (painel de gestão da empresa). Opcional: sem estas duas o painel fica desligado.
# NUNCA a senha em claro: gere o hash com `pnpm --filter backend platform:hash` e cole entre aspas simples
# (o hash contém `$`). Vai no .env do backend (apps/backend/.env). Trocar o hash derruba as sessões abertas.
# PLATFORM_ADMIN_EMAIL="seu-email@empresa.com.br"
# PLATFORM_ADMIN_PASSWORD_HASH='$2b$12$...'

# E-mail transacional (Resend): aviso de novo agendamento à equipe e confirmação/cancelamento/remarcação ao
# cliente. Opcional: sem estas duas o envio fica desligado (nada sai e nada quebra). Vêm JUNTAS. O remetente
# precisa ser de um domínio VERIFICADO no Resend (DNS SPF/DKIM). Vai no .env do backend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Marquo <avisos@seudominio.com.br>"
