# Todas as variáveis estão ativas. `CHAVE=` (vazio) vale como "não definida": o recurso fica desligado e o boot
# não quebra. É só preencher o que for usar. Cópia: apps/backend/.env (e packages/database/.env para o DATABASE_URL).

# Redis compartilhado por todas as instâncias. Em produção use autenticação, rede privada e persistência.
REDIS_URL=redis://127.0.0.1:6379

# Postgres — usado por packages/database e apps/backend
DATABASE_URL="postgresql://totalagenda_app:totalagenda_dev@localhost:5432/totalagenda_dev?schema=public"

# apps/backend
PORT=3001
# Mínimo de 32 caracteres (o boot falha se for menor). Gere com: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="12h"
FRONTEND_URL="http://localhost:3000"

# Origem do site institucional (opcional): libera CORS para ele ler os preços em GET /plans. Ex.: http://localhost:5173
SITE_URL=

# Só em produção, atrás de proxy reverso/CDN: nº de proxies confiáveis (ex.: 1). Sem isso o rate limit por IP enxerga
# o IP do proxy. Deixe vazio em dev local.
TRUST_PROXY_HOPS=

# Segredo COMPARTILHADO com o frontend (mesmo valor nos dois .env) para assinar o IP do visitante nas chamadas
# server-side, senão o throttle por IP vê só o IP do servidor Next e limita o site inteiro junto. 32+ caracteres
# (openssl rand -hex 32). Opcional em dev; OBRIGATÓRIO com NODE_ENV=production (o boot falha sem ele).
CLIENT_IP_SECRET=

# Cobrança (Mercado Pago: cartão recorrente e Pix mensal). Opcional em desenvolvimento: sem o token as rotas de
# cobrança respondem 503 e a tela de plano só informa. Em PRODUÇÃO, com o token, o boot exige também o segredo do
# webhook e a URL pública do backend.
# Access Token da aplicação (Suas integrações > Credenciais). TEST-... em teste, APP_USR-... em produção.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook (Suas integrações > Webhooks), 16+ caracteres. Confere o x-signature das notificações.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública do backend, sem barra no fim: vira o notification_url enviado ao Mercado Pago. Em dev, use um túnel
# (ngrok/Cloudflare) para a porta 3001, porque o Mercado Pago não alcança o localhost. Ex.: https://api.seudominio.com.br
BACKEND_PUBLIC_URL=
# Base do endereço de VOLTA do checkout do cartão (back_url). O Mercado Pago recusa http/localhost ("Invalid value for
# back_url"), então em dev aponte para um túnel https do frontend (porta 3000). Vazio = usa o FRONTEND_URL (em produção,
# que já é https). Só aceita https. Ex.: https://abc123.ngrok-free.app
MERCADOPAGO_BACK_URL_BASE=
# SÓ EM DESENVOLVIMENTO: e-mail do COMPRADOR de teste (painel do Mercado Pago > Contas de teste). Com credenciais de teste o
# pagador precisa ser um usuário de teste; com o e-mail real do dono o Mercado Pago responde "Unauthorized use of live
# credentials". Em produção é proibido (o boot falha). Ex.: test_user_123456@testuser.com
MERCADOPAGO_TEST_PAYER_EMAIL=

# API interna de suporte (/internal/*), chamada só pelo Admin-TotalSoftware. Segredo COMPARTILHADO com o Admin (mesmo
# valor nos dois; 32+ caracteres; openssl rand -hex 32) para assinar (HMAC) cada requisição. Opcional em dev (sem ele
# a API responde 403 a tudo); OBRIGATÓRIO com NODE_ENV=production. Em produção, restrinja /internal/ no proxy ao IP
# do Admin.
INTERNAL_API_SECRET=

# Conta da plataforma (painel de gestão da empresa). Opcional: sem as duas o painel fica desligado.
# NUNCA a senha em claro: gere o hash com `pnpm --filter backend platform:hash` e cole entre aspas simples (o hash
# contém `$`). Trocar o hash derruba as sessões abertas. Ex.: PLATFORM_ADMIN_PASSWORD_HASH='$2b$12$...'
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
# Segundo fator do login da plataforma: "email" manda um código de 6 dígitos ao PLATFORM_ADMIN_EMAIL (exige a conta
# da plataforma e o Resend abaixo configurados). Vazio = desligado.
PLATFORM_ADMIN_2FA=

# E-mail transacional (Resend): aviso de novo agendamento à equipe e confirmação/cancelamento/remarcação ao cliente.
# Opcional: sem estas duas o envio fica desligado (nada sai e nada quebra). Vêm JUNTAS. O remetente precisa ser de um
# domínio VERIFICADO no Resend (DNS SPF/DKIM). Ex.: RESEND_API_KEY="re_..."  EMAIL_FROM="Marquo <avisos@seudominio.com.br>"
RESEND_API_KEY=
EMAIL_FROM=
