# Postgres — usado por packages/database e apps/api
DATABASE_URL="postgresql://totalagenda_app:totalagenda_dev@localhost:5432/totalagenda_dev?schema=public"

# apps/backend
PORT=3001
# Mínimo de 32 caracteres (o boot falha se for menor). Gere com: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="12h"
FRONTEND_URL="http://localhost:3000"
# Origem do site institucional (opcional): libera CORS para ele ler os preços em GET /plans.
# SITE_URL="http://localhost:5173"
# Só em produção, atrás de proxy reverso/CDN: nº de proxies confiáveis (ex.: 1). Sem isso o rate
# limit por IP enxerga o IP do proxy. Não defina em dev local.
# TRUST_PROXY_HOPS=1
# Segredo COMPARTILHADO com o frontend (mesmo valor nos dois .env) para assinar o IP do visitante
# nas chamadas server-side, senão o throttle por IP vê só o IP do servidor Next e limita o site
# inteiro junto. 32+ caracteres (openssl rand -hex 32). Opcional em dev; OBRIGATÓRIO com
# NODE_ENV=production (o boot falha sem ele).
# CLIENT_IP_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"

# Cobrança (Stripe). Opcionais em dev (as rotas de cobrança respondem 503 sem elas); OBRIGATÓRIAS com
# NODE_ENV=production, assim como FRONTEND_URL. Use chaves do modo TESTE em desenvolvimento.
# STRIPE_SECRET_KEY="sk_test_..."
# Segredo de assinatura do endpoint POST /webhooks/stripe (Stripe > Developers > Webhooks). Em dev:
# `stripe listen --forward-to localhost:3001/webhooks/stripe` mostra o whsec_ a usar.
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Price MENSAL de cada plano, criados no Stripe (Product "Marquo"). O preço cobrado vem daqui.
# STRIPE_PRICE_ESSENCIAL="price_..."
# STRIPE_PRICE_PROFISSIONAL="price_..."
# STRIPE_PRICE_PREMIUM="price_..."

# API interna de suporte (/internal/*), chamada só pelo Admin-TotalSoftware. Segredo COMPARTILHADO com o
# Admin (mesmo valor nos dois; 32+ caracteres; openssl rand -hex 32) para assinar (HMAC) cada requisição.
# Opcional em dev (sem ele a API responde 403 a tudo); OBRIGATÓRIO com NODE_ENV=production. Em produção,
# restrinja /internal/ no proxy ao IP do Admin.
# INTERNAL_API_SECRET="CHANGE_ME_min_32_chars_generate_with_openssl_rand_hex_32"
