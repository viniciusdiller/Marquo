generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  OWNER
  RECEPTIONIST
  PROFESSIONAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Ciclo de vida do atendimento. SCHEDULED = criado pela recepção e ainda não confirmado;
// CONFIRMED = firme na agenda (default do agendamento público); IN_SERVICE = cliente em
// atendimento; COMPLETED = finalizado; NO_SHOW = cliente faltou; CANCELED = cancelado.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELED
}

// Origem do agendamento: link público do tenant vs. criado por staff (recepção/dono).
enum AppointmentSource {
  PUBLIC
  STAFF
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  RESOLVED
  CANCELED
}

enum PlanTier {
  ESSENCIAL
  PROFISSIONAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// ─────────────────────────────────────────────
// Comanda / PDV / Estoque / Comissão (M3)
// ─────────────────────────────────────────────

enum TicketStatus {
  OPEN
  CLOSED
  CANCELED
}

enum TicketItemKind {
  SERVICE
  PRODUCT
  CUSTOM
}

// Só REGISTRO da forma de pagamento — não há processamento/PSP nesta fase.
enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  PIX
  OTHER
}

enum StockMovementKind {
  IN // entrada / compra
  OUT // saída manual (uso interno, perda)
  ADJUSTMENT // acerto de inventário (quantity pode ser +/-)
  SALE // baixa por venda em comanda
}

enum CommissionBase {
  SERVICE
  PRODUCT
  ALL
}

enum CommissionKind {
  PERCENT
  FIXED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  OPENING // fundo de troco na abertura
  SALE // pagamento em dinheiro de comanda
  WITHDRAWAL // sangria
  DEPOSIT // suprimento / reforço
}

// ─────────────────────────────────────────────
// Tenant / Auth
// ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  trialEndsAt DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  // Suspensão manual feita pela plataforma (painel de admin). Não nula = acesso bloqueado e fora do
  // marketplace, sem apagar dado nenhum; vence qualquer estado de cobrança (ver computeBillingStatus).
  suspendedAt     DateTime? @db.Timestamptz(6)
  suspendedReason String?

  // Dados apagados pela plataforma (ver TenantDeletionService): a linha do negócio fica ANONIMIZADA, junto com a
  // assinatura e as tentativas de cobrança, porque os termos prometem guardar registros de pagamento pelo prazo legal.
  // Nenhum dado de cliente, equipe, agenda ou financeiro do negócio sobrevive.
  deletedAt DateTime? @db.Timestamptz(6)

  // Perfil público exibido em /[slug] — todos opcionais, editados pelo dono no dashboard.
  description    String?
  address        String?
  businessHours  String? // texto livre (ex: "Seg-Sex 9h-19h"), não agregado automaticamente
  logoUrl        String? // caminho servido pelo backend, ex: /uploads/tenants/<id>/logo.webp
  accentColor    String? // hex "#RRGGBB"; nulo usa o roxo padrão do Marquo
  whatsappNumber String? // só dígitos, com DDI (ex: 5511912345678) — vira link wa.me
  instagramUrl   String?

  // Cada seção aparece automaticamente se tiver conteúdo (serviços cadastrados, fotos na
  // galeria, etc.) — esses toggles deixam o dono escondê-la mesmo assim.
  showServices Boolean @default(true)
  showTeam     Boolean @default(true)
  showGallery  Boolean @default(true)
  showContact  Boolean @default(true)

  // Marketplace de descoberta (M5). listedInMarketplace = opt-in explícito do dono.
  // latitude/longitude alimentam a ordenação por distância (bounding box, sem PostGIS).
  listedInMarketplace Boolean @default(false)
  city                String?
  neighborhood        String?
  latitude            Float?
  longitude           Float?
  priceRange          Int? // 1..4 ($ a $$$$)

  // Limites de agendamento público (antecedência e horizonte máximo)
  minSchedulingLeadTimeMinutes Int @default(120) // mínimo de 2 horas de antecedência
  maxSchedulingLeadTimeDays    Int @default(60) // agenda aberta por no máximo 60 dias

  // Avisos por e-mail à EQUIPE (novo agendamento, cancelamento, remarcação). Desligar não muda o que o CLIENTE recebe
  // (confirmação, cancelamento, remarcação e lembrete continuam saindo).
  notifyStaffByEmail Boolean @default(true)

  users               User[]
  professionals       Professional[]
  services            Service[]
  notificationOutbox  NotificationOutbox[]
  appointments        Appointment[]
  timeBlocks          TimeBlock[]
  waitlist            WaitlistEntry[]
  subscription        Subscription?
  couponRedemptions   CouponRedemption[]
  billingAttempts     BillingAttempt[]
  clients             Client[]
  galleryImages       TenantGalleryImage[]
  intakeForms         IntakeForm[]
  intakeResponses     IntakeResponse[]
  products            Product[]
  stockMovements      StockMovement[]
  tickets             Ticket[]
  payments            Payment[]
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  commissionPayouts   CommissionPayout[]
  cashRegisters       CashRegister[]
  financialCategories FinancialCategory[]
  financialEntries    FinancialEntry[]
  categories          TenantCategory[]
  reviews             Review[]
  consumerLinks       ConsumerTenantLink[]

  @@index([slug])
  @@index([listedInMarketplace, city])
}

// Fotos avulsas da página pública (espaço, trabalhos feitos) — separado de logoUrl porque
// é 0..N por tenant, não 1.
model TenantGalleryImage {
  id        String   @id @default(uuid())
  tenantId  String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, position])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // Telefone de contato do usuário (normalizado: só dígitos, sem DDI 55). Hoje é pedido ao DONO no
  // cadastro e serve ao contato comercial da plataforma (ex.: falar com quem cancelou). Nulo em contas
  // anteriores ao campo e em quem não o informou. Nunca é identidade de login.
  phone String?

  // Link de "definir senha" (/auth/set-password): usado para redefinir a senha de um dono pelo
  // suporte (Admin). Guardamos o hash, nunca o token em claro (mesmo padrão do passwordHash), com
  // validade e uso único.
  passwordSetTokenHash      String?   @unique
  passwordSetTokenExpiresAt DateTime? @db.Timestamptz(6)

  // Confirmação de que o dono do e-mail é quem se cadastrou. Cadastro PÚBLICO nasce sem confirmação e não entra até
  // clicar no link enviado ao e-mail (ver AuthService.login e EmailVerificationService). Contas criadas por quem já tem
  // autoridade (plataforma, dono criando equipe) e as anteriores a este campo nascem confirmadas. Redefinir a senha pelo
  // link enviado ao e-mail também confirma (o link só chega a quem controla a caixa).
  emailVerifiedAt DateTime? @db.Timestamptz(6)

  // Link de confirmação de e-mail: só o hash, com validade e uso único (mesmo padrão do passwordSetTokenHash).
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime? @db.Timestamptz(6)

  // Aceite dos Termos de Uso e da Política de Privacidade no cadastro público (/public/signup):
  // só a data e a versão aceita (LEGAL_DOCS_VERSION). Sem IP, por minimização de dados. Nulo em
  // contas anteriores ao aceite (seed, provisionadas pelo Admin) e em usuários criados pelo dono.
  termsAcceptedAt DateTime? @db.Timestamptz(6)
  termsVersion    String?

  // Quando a senha foi definida/redefinida por último. Tokens (acesso e refresh) emitidos ANTES disto
  // deixam de valer: redefinir a senha (ex.: conta comprometida) precisa derrubar as sessões antigas,
  // e o refresh token de staff dura 30 dias e não é revogável de outra forma.
  passwordChangedAt DateTime? @db.Timestamptz(6)

  // Lockout progressivo por conta (além do rate limit por IP no ThrottlerGuard) — ver
  // AuthService.login. Reseta em login bem-sucedido; nunca exposto em nenhuma resposta (a
  // mensagem de erro é sempre a mesma genérica, logado ou não).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional      Professional?
  openedTickets     Ticket[]
  cashRegisters     CashRegister[]
  financialEntries  FinancialEntry[]
  commissionPayouts CommissionPayout[]
  refreshTokens     RefreshToken[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Profissionais e disponibilidade
// ─────────────────────────────────────────────

model Professional {
  id                     String   @id @default(uuid())
  tenantId               String
  userId                 String   @unique
  bio                    String?
  // Foto do profissional (caminho servido pelo backend, ex.: /uploads/tenants/<id>/professionals/<id>-<v>.webp).
  // Só o servidor grava (upload reprocessado em WebP quadrado); nunca vem de URL do cliente.
  photoUrl               String?
  isActive               Boolean  @default(true)
  slotGranularityMinutes Int      @default(15)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  appointments         Appointment[]
  professionalServices ProfessionalService[]
  waitlistEntries      WaitlistEntry[]
  ticketItems          TicketItem[]
  commissionRules      CommissionRule[]
  commissionEntries    CommissionEntry[]
  commissionPayouts    CommissionPayout[]

  @@index([tenantId, isActive])
}

model WorkingHours {
  id             String   @id @default(uuid())
  professionalId String
  weekday        Weekday
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@index([professionalId, weekday])
}

model TimeBlock {
  id             String   @id @default(uuid())
  tenantId       String
  professionalId String
  startAt        DateTime @db.Timestamptz(6)
  endAt          DateTime @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startAt, endAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// Catálogo de serviços
// ─────────────────────────────────────────────

model Service {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalServices ProfessionalService[]
  appointmentItems     AppointmentItem[]
  waitlistEntries      WaitlistEntry[]
  ticketItems          TicketItem[]

  @@index([tenantId, isActive])
}

model ProfessionalService {
  id              String   @id @default(uuid())
  professionalId  String
  serviceId       String
  durationMinutes Int?
  priceCents      Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// ─────────────────────────────────────────────
// Agendamentos
// ─────────────────────────────────────────────

// Agregado do atendimento (a "comanda" no vocabulário do salão). Um Appointment tem 1+
// AppointmentItem — na M0 os itens são só serviços; produtos entram na M3.
// [startAt, endAt] é o intervalo total (span dos itens) e é o que a constraint EXCLUDE
// usa para impedir sobreposição do mesmo profissional.
model Appointment {
  id               String            @id @default(uuid())
  tenantId         String
  // Profissional responsável pelo atendimento. Na M0 todos os itens são desse profissional;
  // comanda multiprofissional fica para a M3.
  professionalId   String
  // Snapshot do momento da marcação (auditoria) — não editado depois. A identidade "viva"
  // do cliente é a relação clientId.
  clientName       String
  clientPhone      String
  clientId         String?
  startAt          DateTime          @db.Timestamptz(6)
  endAt            DateTime          @db.Timestamptz(6)
  status           AppointmentStatus @default(CONFIRMED)
  source           AppointmentSource @default(PUBLIC)
  notes            String?
  canceledAt       DateTime?         @db.Timestamptz(6)
  noShowAt         DateTime?         @db.Timestamptz(6)
  rescheduledCount Int               @default(0)
  // Lembrete por e-mail ao cliente (ver ReminderService). Não nulo = já foi enviado OU não é mais necessário (marcado
  // com menos de 24 h de antecedência: a confirmação acabou de sair). Voltar a nulo ao remarcar. A fila persistente usa chave
  // única por versão do agendamento e idempotência no provedor.
  reminderSentAt   DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notificationOutbox NotificationOutbox[]
  items           AppointmentItem[]
  intakeResponses IntakeResponse[]
  ticket          Ticket?
  review          Review?
  // Constraint EXCLUDE anti-overlap (professionalId + tstzrange) adicionada manualmente na
  // migration SQL, parcial em status IN (SCHEDULED, CONFIRMED, IN_SERVICE).

  @@index([tenantId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId])
  // Varredura dos lembretes (todos os negócios, por janela de horário).
  @@index([startAt])
}

model AppointmentItem {
  id                 String   @id @default(uuid())
  appointmentId      String
  serviceId          String
  // Ordem do item dentro do atendimento (define a sequência dos serviços).
  position           Int      @default(0)
  // Snapshots do catálogo no momento da marcação (ProfessionalService override > Service).
  durationMinutes    Int
  priceCentsSnapshot Int
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId, position])
  @@index([serviceId])
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  tenantId       String
  serviceId      String
  professionalId String?
  clientName     String
  clientPhone    String
  clientId       String?
  preferredDate  DateTime?      @db.Date
  notes          String?
  status         WaitlistStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// Clientes finais (quem agenda) — identidade por telefone, escopada por tenant
// ─────────────────────────────────────────────
// Criado/atualizado automaticamente a cada agendamento público (upsert por
// [tenantId, phone] normalizado), o que permite login "só por telefone" sem cadastro
// prévio: o primeiro agendamento já cria a conta. v1 não tem verificação (OTP) — ver
// ClientAuthService no backend para o racional e o ponto de extensão futuro.
model Client {
  id        String    @id @default(uuid())
  tenantId  String
  phone     String // normalizado: só dígitos, sem DDI 55
  name      String
  // Cadastro rico (M2) — todos opcionais, preenchidos pela recepção/dono.
  email     String?
  birthDate DateTime? @db.Date
  cpf       String? // só dígitos
  notes     String? // observações livres da equipe (preferências, alergias, histórico)
  tags      String[]  @default([]) // rótulos livres para segmentação (ex.: "VIP", "coloração")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  intakeResponses IntakeResponse[]
  tickets         Ticket[]
  consumerLink    ConsumerTenantLink?

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, name])
}

// ─────────────────────────────────────────────
// Anamnese / ficha (M2)
// ─────────────────────────────────────────────

// Modelo de ficha definido pelo tenant. `fields` é um array JSON de definições:
// [{ key, label, type: "text"|"textarea"|"boolean"|"select", options?: string[], required?: boolean }]
model IntakeForm {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  fields    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responses IntakeResponse[]

  @@index([tenantId, isActive])
}

// Resposta de um cliente a uma ficha. `answers` é um objeto JSON { [fieldKey]: valor }.
// Permite histórico (várias respostas por form/cliente); a UI mostra a mais recente.
model IntakeResponse {
  id            String   @id @default(uuid())
  tenantId      String
  formId        String
  clientId      String
  appointmentId String?
  answers       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form        IntakeForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([formId, clientId])
}

// ─────────────────────────────────────────────
// Comanda / PDV / Estoque / Comissão (M3)
// ─────────────────────────────────────────────

model Product {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  sku        String?
  priceCents Int // preço de venda
  costCents  Int? // custo (para margem/relatório futuro)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  ticketItems    TicketItem[]

  @@index([tenantId, isActive])
}

// Saldo de estoque é derivado (SUM(quantity) por produto) — nunca um campo mutável, para
// não divergir do histórico. ADJUSTMENT/OUT gravam quantity negativa; IN positiva; SALE
// negativa e amarrada a um TicketItem.
model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  productId    String
  kind         StockMovementKind
  quantity     Int // com sinal
  note         String?
  ticketItemId String?           @unique
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  ticketItem TicketItem? @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([productId, createdAt])
}

// Comanda: 1..1 opcional com um Appointment (aberta a partir dele) ou avulsa. Fechamento
// exige soma de pagamentos >= total e gera as baixas de estoque + lançamentos de comissão.
model Ticket {
  id             String       @id @default(uuid())
  tenantId       String
  appointmentId  String?      @unique
  clientId       String?
  openedByUserId String
  status         TicketStatus @default(OPEN)
  discountCents  Int          @default(0)
  note           String?
  openedAt       DateTime     @default(now()) @db.Timestamptz(6)
  closedAt       DateTime?    @db.Timestamptz(6)
  canceledAt     DateTime?    @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment       Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  openedBy          User              @relation(fields: [openedByUserId], references: [id], onDelete: Restrict)
  items             TicketItem[]
  payments          Payment[]
  commissionEntries CommissionEntry[]
  financialEntry    FinancialEntry?

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@index([tenantId, status, closedAt])
}

model TicketItem {
  id             String         @id @default(uuid())
  ticketId       String
  kind           TicketItemKind
  serviceId      String?
  productId      String?
  professionalId String? // quem executou/vendeu — base da comissão
  description    String // snapshot do nome (serviço/produto ou item avulso)
  quantity       Int            @default(1)
  unitPriceCents Int
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service           Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  professional      Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  stockMovement     StockMovement?
  commissionEntries CommissionEntry[]

  @@index([ticketId])
}

// Só REGISTRO — não há captura/PSP nesta fase. cashRegisterId preenchido quando method =
// CASH e há caixa aberto (para o fechamento bater).
model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  ticketId       String
  method         PaymentMethod
  amountCents    Int
  cashRegisterId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([ticketId])
}

// Regra de comissão por profissional. targetId é o id do serviço/produto quando base !=
// ALL (ref solta, sem FK — o alvo pode ser desativado sem quebrar a regra histórica).
model CommissionRule {
  id             String         @id @default(uuid())
  tenantId       String
  professionalId String
  base           CommissionBase
  targetId       String?
  kind           CommissionKind
  value          Int // PERCENT: pontos percentuais (ex.: 30 = 30%); FIXED: centavos
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, isActive])
}

// Lançamento gerado no fechamento da comanda: uma linha por item que casou com uma regra.
model CommissionEntry {
  id             String   @id @default(uuid())
  tenantId       String
  professionalId String
  ticketId       String
  ticketItemId   String
  baseCents      Int // valor do item que serviu de base
  amountCents    Int // comissão calculada
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketItem   TicketItem   @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, createdAt])
}

// Repasse efetivamente pago a um profissional. O saldo a repassar é SEMPRE derivado:
// (Σ CommissionEntry do histórico) − (Σ CommissionPayout). Não existe "fechar período":
// cada pagamento é um lançamento próprio, ligado à despesa PAGA que gerou no Financeiro.
model CommissionPayout {
  id               String   @id @default(uuid())
  tenantId         String
  professionalId   String
  amountCents      Int
  note             String?
  financialEntryId String   @unique
  // Gerada pelo cliente a cada abertura do diálogo de repasse: reenviar a MESMA requisição (duplo
  // clique, retry de rede) devolve o repasse já criado em vez de pagar de novo. NULL = sem chave.
  requestKey       String?
  createdByUserId  String
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  financialEntry FinancialEntry @relation(fields: [financialEntryId], references: [id], onDelete: Restrict)
  createdBy      User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, requestKey])
  @@index([tenantId, professionalId, createdAt])
}

// Sessão de caixa. Só um OPEN por tenant de cada vez (garantido no service).
model CashRegister {
  id                  String             @id @default(uuid())
  tenantId            String
  openedByUserId      String
  status              CashRegisterStatus @default(OPEN)
  openingFloatCents   Int                @default(0)
  closingCountedCents Int?
  openedAt            DateTime           @default(now()) @db.Timestamptz(6)
  closedAt            DateTime?          @db.Timestamptz(6)
  note                String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy  User           @relation(fields: [openedByUserId], references: [id], onDelete: Restrict)
  movements CashMovement[]
  payments  Payment[]

  @@index([tenantId, status])
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegisterId String
  kind           CashMovementKind
  amountCents    Int // sempre positivo; o sinal vem do kind
  note           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([cashRegisterId, createdAt])
}

// ─────────────────────────────────────────────
// Financeiro (M4) — camada gerencial acima do PDV/caixa. Regime de caixa; o par
// dueDate/paidAt dá o "previsto x realizado". Sem PSP/conta bancária/conciliação:
// toda entrada e baixa é feita pela gestão.
// ─────────────────────────────────────────────

enum FinancialDirection {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PENDING
  PAID
  CANCELED
}

enum FinancialEntrySource {
  TICKET // receita gerada ao fechar comanda
  COMMISSION // despesa gerada ao fechar comissões do período
  MANUAL // lançado à mão (aluguel, fornecedor, etc.)
}

model FinancialCategory {
  id         String             @id @default(uuid())
  tenantId   String
  name       String
  direction  FinancialDirection
  parentId   String?
  isArchived Boolean            @default(false)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   FinancialCategory?  @relation("FinancialCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children FinancialCategory[] @relation("FinancialCategoryTree")
  entries  FinancialEntry[]

  @@unique([tenantId, name, direction])
  @@index([tenantId, direction, isArchived])
}

model FinancialEntry {
  id              String               @id @default(uuid())
  tenantId        String
  direction       FinancialDirection
  status          FinancialEntryStatus @default(PENDING)
  source          FinancialEntrySource @default(MANUAL)
  description     String
  amountCents     Int
  categoryId      String?
  counterparty    String? // fornecedor / cliente / profissional (texto livre na v1)
  ticketId        String?              @unique // quando source = TICKET
  dueDate         DateTime             @db.Date
  paidAt          DateTime?            @db.Timestamptz(6)
  paymentMethod   PaymentMethod?
  notes           String?
  createdByUserId String
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ticket           Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdBy        User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  commissionPayout CommissionPayout?

  @@index([tenantId, dueDate])
  @@index([tenantId, status, direction])
  @@index([tenantId, paidAt])
}

// ─────────────────────────────────────────────
// Marketplace de descoberta (M5)
// ─────────────────────────────────────────────
// Consumidor GLOBAL, não escopado por tenant — um login que agenda em vários
// estabelecimentos e avalia. O Client por tenant vira um vínculo (ConsumerTenantLink).
// v1 sem OTP (mesmo racional do ClientAuth) — ponto de extensão antes do go-live real.
// LGPD: consentimento explícito no cadastro, export/exclusão via ConsumerService.

enum ReviewStatus {
  VISIBLE
  HIDDEN // ocultada por moderação
  PENDING_REPORT // denunciada, aguardando revisão
}

model Consumer {
  id                  String    @id @default(uuid())
  phone               String    @unique // normalizado, sem DDI 55
  name                String
  // Único (minúsculo, normalizado no service) pra permitir login por e-mail. Sem verificação
  // de posse ainda: o telefone segue sendo a chave de identidade cross-salão. NULL repetido é
  // permitido pelo Postgres (contas antigas sem e-mail).
  email               String?   @unique
  // null = conta do fluxo antigo (só telefone) ainda não migrada; preenchido no cadastro
  // novo e na etapa de "crie sua senha" do primeiro login (ver ConsumerAuthService). Sem
  // campos de token de convite como em User: aqui o fluxo é síncrono, não por link.
  passwordHash        String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)
  consentedAt         DateTime  @db.Timestamptz(6) // aceite dos termos/privacidade
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  tenantLinks ConsumerTenantLink[]
  reviews     Review[]
  sessions    ConsumerSession[]

  @@index([phone])
}

// Uma linha por dispositivo/login (não por consumidor): sessão deslizante — cada uso próximo do
// vencimento estende expiresAt (ver ConsumerAuthService.refresh), então quem volta ao site
// dentro da janela nunca vê a tela de login, mas cada dispositivo é revogável individualmente
// (ver revokeSession/revokeOtherSessions) sem precisar derrubar os outros.
model ConsumerSession {
  id         String    @id @default(uuid())
  consumerId String
  consumer   Consumer  @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  userAgent  String? // rótulo de dispositivo pro usuário reconhecer na lista ("Chrome, Windows")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  @@index([consumerId])
}

// Liga o consumidor global ao Client daquele tenant (identidade "viva" no negócio).
model ConsumerTenantLink {
  id         String   @id @default(uuid())
  consumerId String
  tenantId   String
  clientId   String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([consumerId, tenantId])
  @@index([tenantId])
}

// Taxonomia global de categorias de estabelecimento (semeada). slug estável para URL.
model ServiceCategory {
  id       String @id @default(uuid())
  slug     String @unique
  name     String
  position Int    @default(0)

  tenants TenantCategory[]
}

model TenantCategory {
  tenantId   String
  categoryId String

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tenantId, categoryId])
  @@index([categoryId])
}

// Avaliação atrelada a UM atendimento concluído (1:1), feita pelo consumidor dono.
model Review {
  id            String       @id @default(uuid())
  tenantId      String
  consumerId    String
  appointmentId String       @unique
  rating        Int // 1..5
  comment       String?
  status        ReviewStatus @default(VISIBLE)
  reportReason  String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consumer    Consumer    @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

// ─────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────
// Sem provedor de pagamento ligado por enquanto (o Stripe foi removido; o Mercado Pago entra depois).
// Este backend mantém o estado necessário para aplicar limites por plano (PlanLimitService) e
// liberar/bloquear acesso (TenantBillingGuard). Hoje o único jeito de um negócio ter Subscription é a
// CORTESIA concedida pelo painel da plataforma (courtesy = true).

model Plan {
  id                 String   @id @default(uuid())
  tier               PlanTier @unique
  name               String
  priceCents         Int
  // Preço rebaixado pela plataforma (nulo = vale o do catálogo). O sync do boot reaplica este valor em priceCents, para
  // o desconto sobreviver a um deploy. Nunca passa do preço do catálogo (ver PlanPricingService).
  priceOverrideCents Int?
  maxProfessionals   Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
  attempts      BillingAttempt[]
}

model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  planId                 String
  status                 SubscriptionStatus
  // Forma de pagamento da assinatura PAGA (nulo = cortesia). Cartão: o provedor cobra todo mês e o
  // currentPeriodEnd acompanha a próxima cobrança. Pix: cada mês é um pagamento; o acesso vai até currentPeriodEnd.
  method                 BillingMethod?
  // Id da assinatura recorrente no provedor (preapproval do Mercado Pago). Só no cartão.
  providerSubscriptionId String?            @unique
  // Cortesia concedida pela plataforma (sem cobrança). Fim em currentPeriodEnd (nulo = sem data de fim).
  // Vencida a cortesia, o acesso bloqueia (ver computeBillingStatus). Não é substituída por um pagamento
  // sem decisão explícita: uma cortesia nunca é confundida com assinatura paga.
  courtesy               Boolean            @default(false)
  // Fim do período pago/da cortesia. Nulo = sem data de fim.
  currentPeriodEnd       DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
}

// ─────────────────────────────────────────────
// Cupons (campanhas para novos clientes). Criados no painel da plataforma, resgatados no cadastro.
// TRIAL_DAYS soma dias ao período de teste na hora. PERCENT/FIXED_CENTS ficam registrados no resgate
// e valem na primeira cobrança quando houver provedor de pagamento (hoje não há).
// ─────────────────────────────────────────────
// Como o dono paga: cartão com cobrança recorrente automática, ou Pix mensal (cada mês é um pagamento novo; sem
// pagamento no mês seguinte o acesso termina em currentPeriodEnd).
enum BillingMethod {
  CARD_RECURRING
  PIX_MONTHLY
}

enum BillingAttemptStatus {
  PENDING
  APPROVED
  FAILED
  EXPIRED
}

enum CouponKind {
  TRIAL_DAYS
  PERCENT
  FIXED_CENTS
}

model Coupon {
  id              String     @id @default(uuid())
  // Sempre maiúsculo, sem espaços (normalizado no servidor): é único e comparado exatamente.
  code            String     @unique
  kind            CouponKind
  // TRIAL_DAYS: dias; PERCENT: 1..100; FIXED_CENTS: centavos.
  value           Int
  description     String?
  // Nulo = ilimitado.
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  validFrom       DateTime?  @db.Timestamptz(6)
  validUntil      DateTime?  @db.Timestamptz(6)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@index([isActive, createdAt])
}

model CouponRedemption {
  id        String    @id @default(uuid())
  couponId  String
  tenantId  String
  // Quando o desconto (PERCENT/FIXED_CENTS) foi de fato abatido de uma cobrança. Nulo = resgatado e ainda não
  // usado (ex.: cupom digitado no cadastro, valendo na primeira cobrança).
  appliedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Um negócio resgata o mesmo cupom no máximo uma vez (e a contagem é decidida pelo banco).
  @@unique([couponId, tenantId])
  @@index([tenantId])
}

// Uma tentativa de pagamento iniciada pelo dono (checkout de cartão ou cobrança Pix). O `id` desta linha é o
// `external_reference` enviado ao Mercado Pago: é por ele que o pagamento/assinatura volta ao negócio certo, nunca
// por algo vindo do corpo de um webhook. Valores (lista, desconto, cobrado) são SEMPRE derivados no servidor.
model BillingAttempt {
  id                 String               @id @default(uuid())
  tenantId           String
  planId             String
  method             BillingMethod
  status             BillingAttemptStatus @default(PENDING)
  listPriceCents     Int
  discountCents      Int                  @default(0)
  // O que foi cobrado nesta tentativa (preço de lista − desconto do cupom). Meses seguintes: preço cheio.
  chargeCents        Int
  // Cupom aplicado (CouponRedemption). `couponReserved` = esta tentativa consumiu um uso NOVO do cupom, que volta
  // se ela falhar/expirar; um resgate antigo (do cadastro) não é devolvido.
  couponRedemptionId String?
  couponReserved     Boolean              @default(false)
  // Id no provedor: assinatura (preapproval) no cartão, pagamento no Pix.
  providerRef        String?              @unique
  expiresAt          DateTime?            @db.Timestamptz(6)
  approvedAt         DateTime?            @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([status, expiresAt])
}

// Refresh token de staff com ROTAÇÃO. Cada token (JWT com jti = id desta linha e fid = familyId) só vale uma
// vez: usar troca por um novo da mesma família. Reapresentar um token já usado FORA da janela de tolerância
// (ver RefreshTokenService) indica cópia do token e revoga a família inteira. Não guarda o token, só o id
// (o JWT é assinado): um vazamento do banco não entrega nenhum token utilizável.
model RefreshToken {
  id              String    @id // = jti do JWT
  userId          String
  familyId        String // uma família por login; todos os tokens derivados dele compartilham
  familyStartedAt DateTime  @db.Timestamptz(6) // teto absoluto da sessão, não some com a rotação
  expiresAt       DateTime  @db.Timestamptz(6)
  usedAt          DateTime? @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Trilha de auditoria das ações do suporte (Admin-TotalSoftware) sobre contas de tenants. Nunca guarda
// o token/link gerado. Sem FK de propósito: o registro sobrevive à exclusão do tenant ou do usuário.
model AdminAuditLog {
  id           String   @id @default(uuid())
  action       String // ex.: PASSWORD_RESET_LINK
  actor        String // e-mail do admin (Admin-TotalSoftware ou conta da plataforma)
  tenantId     String?
  targetUserId String?
  // Contexto curto da ação (ex.: "+14 dias", motivo da suspensão). Nunca token nem segredo.
  detail       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

// Durable email jobs. Payload is an immutable template snapshot, deleted with the appointment/tenant.
enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model NotificationOutbox {
  id                 String @id @default(uuid())
  tenantId           String
  appointmentId      String
  event              String
  appointmentVersion Int
  deduplicationKey   String @unique
  payload            Json
  status             NotificationStatus @default(PENDING)
  attempts           Int @default(0)
  availableAt        DateTime @default(now()) @db.Timestamptz(6)
  lockedUntil        DateTime? @db.Timestamptz(6)
  lockToken          String?
  firstAttemptAt     DateTime? @db.Timestamptz(6)
  sentAt             DateTime? @db.Timestamptz(6)
  lastError          String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([appointmentId, event, appointmentVersion])
  @@index([tenantId, createdAt])
}
